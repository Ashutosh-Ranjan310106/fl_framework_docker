# Environment Variables Example for FL Security Framework

EXPERIMENT_ID=cifar10_baseline_001
NUM_ROUNDS=3
MIN_FIT_CLIENTS=2
MIN_AVAILABLE_CLIENTS=2

SERVER_ADDRESS=0.0.0.0:8080
