# ==============================================================================
# FLOWER FEDERATED LEARNING NETWORK CONFIGURATION
# ==============================================================================

# Option A: Local Docker containers on the same machine (RECOMMENDED DEFAULT)
# Containers communicate directly over the Docker internal bridge network.
SERVER_ADDRESS=server:8080
MONITORING_URL=http://server:8000

# Option B: External clients running on ANOTHER PC / LAN / Global IP
# Uncomment below and set to your Host machine IP:
# SERVER_ADDRESS=192.168.1.100:8080
# MONITORING_URL=http://192.168.1.100:8000

# ==============================================================================
# FEDERATED TRAINING PARAMETERS
# ==============================================================================
NUM_ROUNDS=3
MIN_FIT_CLIENTS=2
MIN_AVAILABLE_CLIENTS=2

# ==============================================================================
# ACTIVE DATASET PARTITION (Select distribution strategy)
# ==============================================================================
# 1. IID Distribution (Default):
PARTITION_DIR=./datasets/partitions/cifar10/iid/clients_10_seed_42

# 2. Non-IID Dirichlet (Alpha = 0.5):
# PARTITION_DIR=./datasets/partitions/cifar10/dirichlet/clients_10_alpha_0_5_seed_42

# 3. Non-IID Label Skew (2 Classes per Client):
# PARTITION_DIR=./datasets/partitions/cifar10/label_skew/clients_10_classes_2_seed_42

# 4. Non-IID Quantity Skew (Imbalanced sample volume):
# PARTITION_DIR=./datasets/partitions/cifar10/quantity_skew/clients_10_min1000_max9000_seed_42
